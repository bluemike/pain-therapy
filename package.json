{
  "name": "pain-therapy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "description": "Patient management for pain therapy according to Liebscher & Bracht (Ayanta)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "eslint . && npm run lint -w @pain-therapy/patient-zone",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "test": "vitest run && npm test --workspaces --if-present",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "catalog:sync": "node prisma/catalog/sync.mjs",
    "media:placeholders": "tsx scripts/exercise-media-placeholders.ts",
    "media:audio": "tsx scripts/exercise-audio.ts",
    "postinstall": "prisma generate",
    "build:zone": "prisma generate && npm run build -w @pain-therapy/patient-zone",
    "build:all": "npm run build && npm run build -w @pain-therapy/patient-zone",
    "dev:zone": "npm run dev -w @pain-therapy/patient-zone"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.18"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "@fontsource/inter": "^5.3.0",
    "@pain-therapy/shared": "*",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "next": "^15.5.27",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "perfect-freehand": "^1.2.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
