// Data model for Iteration 1 (see openspec/changes/iteration-1-scaffolding-patient-management/design.md, D5),
// Iteration 2 (openspec/changes/iteration-2-treatments/design.md, D1) and Iteration 3
// (openspec/changes/iteration-3-home-exercises/design.md, D2, D4, D5)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  de
  en
}

/// Hörsprache bei deutscher Oberfläche (iteration 15, design D3): Hochdeutsch or Mundart; English follows the language
enum AudioLanguage {
  de
  gsw
}

enum Gender {
  m
  w
  d
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum YesNo {
  YES
  NO
}

enum Pregnancy {
  YES
  NO
  NOT_APPLICABLE
}

enum SignatureStatus {
  OPEN
  ABORTED
  SIGNED
}

/// Where the patient signed (iteration 5, design D6)
enum SignatureChannel {
  IPAD
  PATIENT_ZONE
}

enum ConsentKind {
  LIABILITY_WAIVER
  DATA_PROCESSING
  UNENCRYPTED_EMAIL
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_NO_CONSENT
  SKIPPED_NO_ADDRESS
}

/// Berufsbezeichnung (user-profile, iteration 8 design D9): "Therapeutin" or "Therapeut"
/// Iteration 10, design D3
enum NoteInputMode {
  KEYBOARD
  HANDWRITING_TEXT
  HANDWRITING_IMAGE
}

enum ProfessionalTitle {
  THERAPIST_F
  THERAPIST_M
}

/// A signed-in Ayanta user. Created on first sign-in from the Entra ID token.
model User {
  id             String            @id @default(cuid())
  /// Subject of the former Entra sign-in (until iteration 12); null for users invited afterwards
  entraOid       String?           @unique
  /// Sign-in address, lower case (therapist-login)
  email          String            @unique
  name           String
  /// "Hallo <displayName>"; first name of the name until the user changes it under "Mein Profil"
  displayName    String?
  title          ProfessionalTitle @default(THERAPIST_F)
  locale         Language          @default(de)
  place          String?
  createdAt      DateTime          @default(now())
  lastLoginAt    DateTime          @default(now())
  /// Sessions issued before this time are rejected (sign-out, access-control, reset of the sign-in)
  signedOutAt    DateTime?
  /// Platform administrator (design D3): manages practices, never sees patient data
  platformAdmin  Boolean           @default(false)
  /// Set once the invited user has set up a second factor (design D2); no sign-in before
  activatedAt    DateTime?
  /// TOTP secret, AES-256-GCM encrypted (src/lib/auth/crypto.ts); confirmed with a first code
  totpSecretEnc  String?
  /// Secret shown during the TOTP setup, until the first code confirms it
  totpPendingEnc String?
  totpEnabledAt  DateTime?
  /// Eingabe bei Bemerkungen (iteration 10, design D3): last choice, default for every remark field
  noteInputMode  NoteInputMode     @default(KEYBOARD)
  /// Audiosprache (iteration 15, design D3), used while the interface is German
  audioLanguage  AudioLanguage     @default(de)
  /// Handynummer in E.164 (iteration 16, design D7): only for invitations, resets and the mailbox notice
  mobile         String?

  memberships   PracticeMembership[]
  passkeys      Passkey[]
  recoveryCodes RecoveryCode[]
  mailboxes     MailboxProvisioning[]
}

/// WebAuthn credential of a user (design D2), registered with user verification
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// base64url credential id
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  /// e.g. "iPad" from the user agent, for the list under "Anmeldung"
  label        String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// Single-use recovery code (10 per user), stored as HMAC (design D2)
model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String    @unique
  usedAt   DateTime?

  @@index([userId])
}

enum LoginCodePurpose {
  LOGIN
  INVITATION
  /// Iteration 16 (design D1): code by SMS when an invitation by SMS is opened
  INVITATION_SMS
  /// Iteration 16 (design D7): code by SMS to a new mobile number under «Mein Profil»
  MOBILE_CHANGE
  /// Iteration 16 (Nachtrag): code by email to a new sign-in address under «Mein Profil»
  EMAIL_CHANGE
}

/// 6-digit code sent by email (design D2): valid 10 minutes, single use. After the code is confirmed, the ticket
/// (httpOnly cookie) carries the first factor to the second step.
model LoginCode {
  id           String           @id @default(cuid())
  email        String
  purpose      LoginCodePurpose
  invitationId String?
  invitation   Invitation?      @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  codeHash     String
  /// MOBILE_CHANGE / EMAIL_CHANGE: the new number or address the code went to (iteration 16)
  target       String?
  expiresAt    DateTime
  verifiedAt   DateTime?
  ticketHash   String?          @unique
  /// Set when the ticket signed in (or the code was replaced by a newer one)
  usedAt       DateTime?
  createdAt    DateTime         @default(now())

  @@index([email, createdAt])
}

/// Wrong codes per address and IP, for the 15-minute lock after 5 failures (therapist-login: Schutz vor Erraten)
model LoginFailure {
  id        String   @id @default(cuid())
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// WebAuthn challenge, single use, valid 5 minutes
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  /// Registration: the user the passkey is for; null for a sign-in
  userId    String?
  expiresAt DateTime
}

/// Invitation to a practice or to the platform (design D4): 7 days, single use
model Invitation {
  id            String            @id @default(cuid())
  email         String
  /// null for an invitation as platform administrator
  practiceId    String?
  practice      Practice?         @relation(fields: [practiceId], references: [id])
  roles         PracticeRole[]
  platformAdmin Boolean           @default(false)
  /// Name of the invited person, taken over by the account (phase 5)
  name          String?
  tokenHash     String            @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  invitedBy     String
  createdAt     DateTime          @default(now())
  /// Iteration 16 (design D1): by e-mail (default) or SMS to `mobile` (E.164)
  channel       InvitationChannel @default(EMAIL)
  mobile        String?
  /// Iteration 19 (design D1): private address for the invitation mail and the e-mail code when it differs from the
  /// sign-in address (a mailbox at pain-therapy.online nobody reads yet)
  notifyEmail   String?

  loginCodes LoginCode[]
  sms        SmsMessage[]
  mailbox    MailboxProvisioning?

  @@index([email])
}

model Patient {
  practiceId               String        @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice                 Practice      @relation(fields: [practiceId], references: [id])
  id                       String        @id @default(cuid())
  firstName                String
  lastName                 String
  gender                   Gender?
  dateOfBirth              DateTime      @db.Date
  preferredLanguage        Language      @default(de)
  /// Audiosprache in der Patienten-Zone (iteration 15, design D3) while preferredLanguage is de
  audioLanguage            AudioLanguage @default(de)
  occupation               String?
  gp                       String?
  street                   String?
  zip                      String?
  city                     String?
  phone                    String?
  mobile                   String?
  email                    String?
  emergencyName            String?
  emergencyPhone           String?
  insurer                  String?
  insuranceNumber          String?
  status                   PatientStatus @default(ACTIVE)
  deactivatedAt            DateTime?
  deactivationReason       String?
  /// Iteration 18 (design D2): text version the practice asked for at a new treatment or session
  signatureRequiredVersion Int?
  createdAt                DateTime      @default(now())
  createdBy                String
  updatedAt                DateTime      @updatedAt
  updatedBy                String

  anamnesis         Anamnesis?
  signatureSessions SignatureSession[]
  documents         SignedDocument[]
  auditEvents       AuditEvent[]
  treatments        Treatment[]
  handouts          ExerciseHandout[]
  accessLinks       PatientAccessLink[]
  zoneSessions      PatientZoneSession[]
  exerciseLog       ExerciseLogEntry[]
  photoHandoffs     PhotoHandoff[]

  @@index([lastName, dateOfBirth])
  @@index([status, lastName])
}

/// Medical part of the intake form ("Anamnese L&B-Patienten", page 2)
model Anamnesis {
  practiceId          String    @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice            Practice  @relation(fields: [practiceId], references: [id])
  patientId           String    @id
  patient             Patient   @relation(fields: [patientId], references: [id])
  smoker              YesNo     @default(NO)
  smokingYears        Int?
  packsPerDay         Decimal?  @db.Decimal(4, 1)
  highBloodPressure   Boolean   @default(false)
  highBloodLipids     Boolean   @default(false)
  dizziness           Boolean   @default(false)
  osteoporosis        Boolean   @default(false)
  arthrosis           Boolean   @default(false)
  rheumatism          Boolean   @default(false)
  orthoOther          Boolean   @default(false)
  orthoOtherText      String?
  cardiovascular      Boolean   @default(false)
  diabetes            Boolean   @default(false)
  asthma              Boolean   @default(false)
  allergies           Boolean   @default(false)
  internalOther       Boolean   @default(false)
  internalOtherText   String?
  furtherDiagnoses    String?
  /// Handschrift-Bild statt Text (iteration 10, design D5)
  furtherDiagnosesInk Json?
  medication          String?
  pregnancy           Pregnancy @default(NOT_APPLICABLE)
  inTreatment         YesNo     @default(NO)
  treatingDoctor      String?
}

/// Versioned disclaimer text (liability waiver, patient information, privacy notice), one row per version and language
model ConsentTextVersion {
  practiceId     String   @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice       Practice @relation(fields: [practiceId], references: [id])
  id             String   @id @default(cuid())
  version        Int
  language       Language
  title          String
  body           String
  publishedAt    DateTime @default(now())
  publishedBy    String
  /// Iteration 18 (design D1): true = everyone signs again at once; false = only at the next new treatment or session
  resignRequired Boolean  @default(false)

  sessions SignatureSession[]

  @@unique([practiceId, version, language])
}

model SignatureSession {
  practiceId      String              @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice        Practice            @relation(fields: [practiceId], references: [id])
  id              String              @id @default(cuid())
  patientId       String
  patient         Patient             @relation(fields: [patientId], references: [id])
  textVersionId   String
  textVersion     ConsentTextVersion  @relation(fields: [textVersionId], references: [id])
  language        Language
  status          SignatureStatus     @default(OPEN)
  startedBy       String
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  /// Iteration 17 (design D1): practice details filled into the form fields when the PDF was made
  fieldValues     Json?
  abortedAt       DateTime?
  patientNote     String?
  place           String?
  signaturePoints Json?
  signatureSvg    String?
  channel         SignatureChannel    @default(IPAD)
  /// Device session of the patient zone that opened the form (channel PATIENT_ZONE)
  zoneSessionId   String?
  zoneSession     PatientZoneSession? @relation(fields: [zoneSessionId], references: [id])
  /// "Erledigt" on the patient's remark about her personal details
  noteResolvedAt  DateTime?
  noteResolvedBy  String?

  consents Consent[]
  document SignedDocument?

  @@index([patientId, startedAt])
  @@index([status, completedAt])
}

model Consent {
  practiceId String           @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice   Practice         @relation(fields: [practiceId], references: [id])
  id         String           @id @default(cuid())
  sessionId  String
  session    SignatureSession @relation(fields: [sessionId], references: [id])
  kind       ConsentKind
  granted    Boolean
  createdAt  DateTime         @default(now())

  @@unique([sessionId, kind])
}

/// Archived PDF. Rows are immutable (enforced by a database trigger); the file lives in immutable Blob Storage.
model SignedDocument {
  practiceId     String           @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice       Practice         @relation(fields: [practiceId], references: [id])
  id             String           @id @default(cuid())
  documentNumber String
  patientId      String
  patient        Patient          @relation(fields: [patientId], references: [id])
  sessionId      String           @unique
  session        SignatureSession @relation(fields: [sessionId], references: [id])
  textVersion    Int
  language       Language
  blobPath       String
  sha256         String
  sizeBytes      Int
  createdAt      DateTime         @default(now())

  deliveries EmailDelivery[]

  @@unique([practiceId, documentNumber])
  @@index([patientId, createdAt])
}

model EmailDelivery {
  practiceId  String         @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice    Practice       @relation(fields: [practiceId], references: [id])
  id          String         @id @default(cuid())
  documentId  String
  document    SignedDocument @relation(fields: [documentId], references: [id])
  recipient   String?
  status      EmailStatus    @default(PENDING)
  attempts    Int            @default(0)
  lastError   String?
  sentAt      DateTime?
  requestedBy String
  /// Iteration 16: address of the therapist who sent it, for Reply-To; null for the practice contact address
  replyTo     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

/// Append-only access and change log (enforced by a database trigger)
model AuditEvent {
  practiceId String?   @default(dbgenerated("NULLIF(current_setting('app.practice_id'::text, true), ''::text)"))
  practice   Practice? @relation(fields: [practiceId], references: [id])
  id         String    @id @default(cuid())
  at         DateTime  @default(now())
  userId     String
  userName   String
  patientId  String?
  patient    Patient?  @relation(fields: [patientId], references: [id])
  action     String
  field      String?
  before     String?
  after      String?
  details    Json?

  @@index([patientId, at])
}

/// Sequence for human-readable document numbers (<Kürzel>-YYYY-NNNNN), per practice (iteration 12, design D5)
model DocumentCounter {
  practiceId String   @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice   Practice @relation(fields: [practiceId], references: [id])
  year       Int
  last       Int      @default(0)

  @@id([practiceId, year])
}

// ---------- Therapy catalog (therapy-catalog, design D2) ----------
// Loaded from prisma/catalog/ by `npm run catalog:sync`. Rows are never deleted; entries that disappear from the
// reference files get `retiredAt` so recorded consultations keep their meaning.

/// Emphasis of a point on the paper form: orange bold, orange, black
enum PointEmphasis {
  main
  relevant
  standard
}

/// Bereich (body-areas, iteration 8 design D1): 1 Kopf, 2 Rumpf, 3 Schulter/Arm, 4 Becken/Beine
model BodyArea {
  id        Int       @id
  nameDe    String
  nameEn    String
  retiredAt DateTime?

  regions   Region[]
  points    OsteopressurePoint[]
  exercises Exercise[]
}

/// Schmerzbereich: one of the 12 treatment areas (Behandlungsbögen) of the Sammelmappe, "1.1" to "4.3"
model Region {
  id         Int       @id
  /// "<Bereich>.<n>", e.g. "1.2"
  code       String
  bodyAreaId Int
  bodyArea   BodyArea  @relation(fields: [bodyAreaId], references: [id])
  nameDe     String
  nameEn     String
  sheetTitle String
  retiredAt  DateTime?

  points     RegionPoint[]
  exercises  RegionExercise[]
  treatments Treatment[]
}

model OsteopressurePoint {
  /// e.g. "2.11.1"
  id                    String    @id
  /// Bereich (iteration 8 design D1; formerly "Gruppe")
  group                 Int
  bodyArea              BodyArea  @relation(fields: [group], references: [id])
  muscleAttachmentLatin String
  attachmentDe          String
  /// Behandlungslage (iteration 15, design D1): code of a TreatmentPosition or a combination such as "BL/HSL"
  position              String?
  /// Order of the reference file (numeric by ID)
  sort                  Int
  retiredAt             DateTime?

  regions       RegionPoint[]
  consultations ConsultationPoint[]
}

/// A point on the form of an area, in paper order
model RegionPoint {
  regionId  Int
  region    Region             @relation(fields: [regionId], references: [id])
  pointId   String
  point     OsteopressurePoint @relation(fields: [pointId], references: [id])
  emphasis  PointEmphasis
  sort      Int
  retiredAt DateTime?

  @@id([regionId, pointId])
}

/// Engpassdehnung 1A to 4G
model Exercise {
  code         String    @id
  /// Bereich (iteration 8 design D1; formerly "Gruppe")
  group        Int
  bodyArea     BodyArea  @relation(fields: [group], references: [id])
  nameDe       String
  nameEn       String
  stretchSteps Int?
  /// [{ order, toolCode, areaDe, note? }], null while not yet captured
  rolling      Json?
  /// [{ order, de }], null while not yet captured
  variants     Json?
  source       String?
  sort         Int
  retiredAt    DateTime?

  regions       RegionExercise[]
  consultations ConsultationExercise[]
  sheet         ExerciseSheet?
  prescriptions HomePrescription[]
  epdVariants   ExerciseVariant[]
}

/// Variante der Engpassdehnung (exercise-segments, iteration 8 design D2). Texts in ExerciseSheet.segments.
model ExerciseVariant {
  exerciseCode String
  exercise     Exercise  @relation(fields: [exerciseCode], references: [code])
  /// 1…n per exercise
  number       Int
  /// Numbers of the images in the variant band, e.g. [1, 2]
  images       Int[]
  aids         String[]
  /// null: same as the standard exercise
  seconds      Int?
  retiredAt    DateTime?

  @@id([exerciseCode, number])
}

model RegionExercise {
  regionId     Int
  region       Region    @relation(fields: [regionId], references: [id])
  exerciseCode String
  exercise     Exercise  @relation(fields: [exerciseCode], references: [code])
  sort         Int
  retiredAt    DateTime?

  @@id([regionId, exerciseCode])
}

/// Fascia rolling tool (MiKu, MeKu, MiRo, MeRo)
/// Behandlungslage of an Osteopressur point (iteration 15, design D1), e.g. SL Seitenlage
model TreatmentPosition {
  code      String    @id
  nameDe    String
  nameEn    String
  sort      Int
  retiredAt DateTime?
}

model RollingTool {
  code      String    @id
  nameDe    String
  nameEn    String
  sort      Int
  retiredAt DateTime?
}

// ---------- Treatments and consultations (design D1, D4) ----------

enum Sensitivity {
  LOW
  MEDIUM
  STRONG
  EXTREME
}

/// "Übung fällt"
enum Difficulty {
  EASY
  MEDIUM
  HARD
  IMPOSSIBLE
}

/// Körperseite of a treatment (session-form, iteration 8 design D4)
enum Side {
  UNSPECIFIED
  LEFT
  RIGHT
}

/// One treatment per pain area; never deleted (database trigger)
model Treatment {
  practiceId   String   @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice     Practice @relation(fields: [practiceId], references: [id])
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  startedAt    DateTime
  regionId     Int
  region       Region   @relation(fields: [regionId], references: [id])
  /// Fixed after the first session, like the pain area
  side         Side     @default(UNSPECIFIED)
  /// "Schmerzlokalisation und Schmerzzustand" (iteration 8 design D10)
  diagnosis    String
  /// Diagnose als Handschrift (iteration 10, design D5): { v, w, h, strokes, svg }; diagnosis is then ''
  diagnosisInk Json?
  /// Pain at the start in percent, 0 to 100 in steps of 10
  painStart    Int
  createdAt    DateTime @default(now())
  createdBy    String
  updatedAt    DateTime @updatedAt
  updatedBy    String

  consultations Consultation[]
  photos        ClinicalPhoto[]

  @@index([patientId, startedAt])
}

/// One session, i.e. one paper form; never deleted (database trigger)
model Consultation {
  practiceId    String    @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice      Practice  @relation(fields: [practiceId], references: [id])
  id            String    @id @default(cuid())
  treatmentId   String
  treatment     Treatment @relation(fields: [treatmentId], references: [id])
  /// "Behandlung Nr." on the paper form: 1, 2, 3 … within the treatment, fixed when created
  number        Int
  at            DateTime
  diagnosis     String
  painBefore    Int?
  /// Residual pain after the consultation
  painAfter     Int?
  comparison    String?
  /// Handschrift-Bild statt Text (iteration 10, design D5)
  diagnosisInk  Json?
  comparisonInk Json?
  createdAt     DateTime  @default(now())
  createdBy     String
  updatedAt     DateTime  @updatedAt
  updatedBy     String

  points    ConsultationPoint[]
  exercises ConsultationExercise[]
  photos    ClinicalPhoto[]
  home      HomePrescription[]
  handouts  ExerciseHandout[]

  @@unique([treatmentId, number])
}

/// Only stored when at least one value is given
model ConsultationPoint {
  practiceId     String             @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice       Practice           @relation(fields: [practiceId], references: [id])
  consultationId String
  consultation   Consultation       @relation(fields: [consultationId], references: [id])
  pointId        String
  point          OsteopressurePoint @relation(fields: [pointId], references: [id])
  left           Boolean            @default(false)
  right          Boolean            @default(false)
  sensitivity    Sensitivity?

  @@id([consultationId, pointId])
}

model ConsultationExercise {
  practiceId     String        @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice       Practice      @relation(fields: [practiceId], references: [id])
  consultationId String
  consultation   Consultation  @relation(fields: [consultationId], references: [id])
  exerciseCode   String
  exercise       Exercise      @relation(fields: [exerciseCode], references: [code])
  /// Prescribed = performed in the session and part of the home program (iteration 8 design D6)
  prescribed     Boolean       @default(false)
  /// Required when prescribed
  difficulty     Difficulty?
  /// EPD: null = Standardübung, otherwise the number of the ExerciseVariant
  variant        Int?
  /// Verordnete Teile (iteration 15, design D6)
  parts          ExerciseParts @default(FRM_EPD)

  @@id([consultationId, exerciseCode])
}

// ---------- Clinical photos (clinical-photos, design D5, D6) ----------

/// Photo of a treatment, optionally of one of its consultations. Removing only hides it; the file stays.
model ClinicalPhoto {
  practiceId     String        @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice       Practice      @relation(fields: [practiceId], references: [id])
  id             String        @id @default(cuid())
  treatmentId    String
  treatment      Treatment     @relation(fields: [treatmentId], references: [id])
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  blobPath       String
  thumbPath      String
  sha256         String
  width          Int
  height         Int
  sizeBytes      Int
  /// When the photo was taken (EXIF DateTimeOriginal), otherwise when it was added
  takenAt        DateTime
  uploadedAt     DateTime      @default(now())
  uploadedBy     String
  removedAt      DateTime?
  removedBy      String?

  @@index([treatmentId, takenAt])
  @@index([consultationId])
}

/// Fotos mit dem Smartphone (iteration 15, design D5): a QR link that can only upload, 15 minutes, at most 10 photos
model PhotoHandoff {
  practiceId  String    @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice    Practice  @relation(fields: [practiceId], references: [id])
  id          String    @id @default(cuid())
  /// SHA-256 of the 32-byte token in the link; the token itself is never stored
  tokenHash   String    @unique
  /// Four characters shown on the iPad and the phone, so the therapist sees the right phone is connected
  checkCode   String
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id])
  /// The treatment of the form, if it exists already (null while a new treatment is being opened)
  treatmentId String?
  createdById String
  createdBy   String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  /// «Beenden»: the link no longer accepts photos
  endedAt     DateTime?
  maxPhotos   Int       @default(10)

  uploads PhotoHandoffUpload[]
}

/// A photo sent from the phone; taken over into a ClinicalPhoto when the form is saved, otherwise deleted after 24 h
model PhotoHandoffUpload {
  practiceId String       @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice   Practice     @relation(fields: [practiceId], references: [id])
  id         String       @id
  handoffId  String
  handoff    PhotoHandoff @relation(fields: [handoffId], references: [id])
  blobPath   String
  thumbPath  String
  sha256     String
  width      Int
  height     Int
  sizeBytes  Int
  takenAt    DateTime
  uploadedAt DateTime     @default(now())
  /// Set when the form was saved and the photo became a ClinicalPhoto with the same id and files
  claimedAt  DateTime?

  @@index([handoffId])
}

/// Upload attempts per IP (HMAC) for the limit of 30 per hour; no practice data
model PhotoHandoffAttempt {
  id     String   @id @default(cuid())
  ipHash String
  at     DateTime @default(now())

  @@index([ipHash, at])
}

// ---------- Exercise sheets (exercise-library, iteration 3 design D1 to D3) ----------
// Timing and file names from prisma/catalog/exercise-sheets.json, texts from `exercises-content.json` in the
// private container `exercise-media` (never in the repository). Loaded by `npm run catalog:sync` like the catalog.

/// One of the 27 sheets of the "Sammelmappe 27 Übungsblätter"
model ExerciseSheet {
  exerciseCode          String    @id
  exercise              Exercise  @relation(fields: [exerciseCode], references: [code])
  /// Page in the Sammelmappe
  sheetPage             Int
  title                 String
  /// File names in the container `exercise-media`
  mainImage             String
  sheetImage            String
  /// ["Schritt 1", "Schritt 2", …] as printed on the sheet
  stepLabels            Json
  /// null: not yet set by the practice ("noch nicht festgelegt")
  stretchSecondsPerSide Int?
  sides                 Int
  rollingSeconds        Int?
  timingSource          String?
  /// Open points of the timing, e.g. "Dauer von der Praxis festlegen"
  timingTodo            Json?
  /// { rolling, steps: [{ label, text }], variants } from the container; null while "noch nicht erfasst"
  content               Json?
  /// FRM tools (iteration 8 design D2), e.g. ["MiKu", "MiRo"]
  rollingTools          String[]  @default([])
  /// Aids of the EPD standard exercise, e.g. ["Wand"]
  standardAids          String[]  @default([])
  /// FRM, Standardübung and Varianten from segments-content.json in the container; null while "noch nicht erfasst"
  segments              Json?
  retiredAt             DateTime?
}

// ---------- Home program and exercise handout (home-program, exercise-handout, design D4 to D6) ----------

/// Teile einer Verordnung (iteration 15, design D6): FRM + EPD, only the stretch or only the Faszien-Rollmassage
enum ExerciseParts {
  FRM_EPD
  EPD
  FRM
}

/// Selbstausführung: one row per exercise prescribed in a session, FRM and/or the chosen EPD (iteration 8 design D7,
/// iteration 15 design D6)
model HomePrescription {
  practiceId     String        @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice       Practice      @relation(fields: [practiceId], references: [id])
  consultationId String
  consultation   Consultation  @relation(fields: [consultationId], references: [id])
  exerciseCode   String
  exercise       Exercise      @relation(fields: [exerciseCode], references: [code])
  /// Copy of ConsultationExercise.variant: null = EPD Standard
  variant        Int?
  /// Copy of ConsultationExercise.parts (iteration 15, design D6)
  parts          ExerciseParts @default(FRM_EPD)
  /// 1 to 3 executions per day
  timesPerDay    Int           @default(1)
  /// Bit mask Mo = 1, Di = 2 … So = 64; 127 = every day, at least one day
  weekdays       Int           @default(127)
  note           String?

  logEntries ExerciseLogEntry[]

  @@id([consultationId, exerciseCode])
}

enum HandoutChannel {
  EMAIL
  PRINT
}

/// Personal exercise sheet (PDF). Rows are immutable (database trigger); the file lives in the document archive.
model ExerciseHandout {
  practiceId     String       @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice       Practice     @relation(fields: [practiceId], references: [id])
  id             String       @id @default(cuid())
  documentNumber String
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  /// 1, 2, 3 … per consultation; the newest is the current one
  version        Int
  language       Language
  /// The prescriptions as printed, so older versions stay readable after changes
  prescriptions  Json
  blobPath       String
  sha256         String
  sizeBytes      Int
  createdAt      DateTime     @default(now())
  createdBy      String

  deliveries HandoutDelivery[]

  @@unique([consultationId, version])
  @@unique([practiceId, documentNumber])
  @@index([patientId, createdAt])
}

/// Email (with status and retries, like EmailDelivery) or printout of a handout; never deleted (database trigger)
model HandoutDelivery {
  practiceId  String          @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice    Practice        @relation(fields: [practiceId], references: [id])
  id          String          @id @default(cuid())
  handoutId   String
  handout     ExerciseHandout @relation(fields: [handoutId], references: [id])
  channel     HandoutChannel
  recipient   String?
  /// Email only; null for a printout
  status      EmailStatus?
  attempts    Int             @default(0)
  lastError   String?
  sentAt      DateTime?
  requestedBy String
  /// Iteration 16: address of the therapist who sent it, for Reply-To; null for the practice contact address
  replyTo     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// ---------- Patient zone (patient-access, exercise-log; iteration 4 design D3 to D8) ----------
// Read and written by the separate app apps/patient-zone with the database role `patient_zone`
// (prisma/patient-zone-role.sql). The token of a link is never stored, only its SHA-256.

/// Personal link to the patient zone. One valid link per patient: a new link replaces the previous one.
model PatientAccessLink {
  practiceId     String    @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice       Practice  @relation(fields: [practiceId], references: [id])
  id             String    @id @default(cuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id])
  /// SHA-256 (hex) of the token in https://<host>/l/<token>
  tokenHash      String    @unique
  createdBy      String
  createdAt      DateTime  @default(now())
  /// Issued + 6 months
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedBy      String?
  /// Set when a newer link of the same patient was issued; sessions opened with it stay valid
  replacedAt     DateTime?
  /// Failed confirmations with the date of birth since the last success
  failedAttempts Int       @default(0)
  /// 15 minutes after 5 failed confirmations
  lockedUntil    DateTime?
  /// After 10 failed confirmations, until the practice issues a new link
  blockedAt      DateTime?
  lastUsedAt     DateTime?

  deliveries AccessLinkDelivery[]
  sessions   PatientZoneSession[]
  attempts   PatientZoneAttempt[]

  @@index([patientId, createdAt])
}

/// "Link senden": by email (no attachment), shown as QR code on screen or printed as access sheet
enum AccessLinkChannel {
  EMAIL
  SCREEN
  PRINT
}

/// How a link reached the patient, with the email status like HandoutDelivery; never contains the token
/// Why a link went out: the home program (iteration 4) or the invitation to sign (iteration 5, design D3)
enum AccessLinkPurpose {
  EXERCISES
  SIGNATURE
}

model AccessLinkDelivery {
  practiceId  String            @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice    Practice          @relation(fields: [practiceId], references: [id])
  id          String            @id @default(cuid())
  linkId      String
  link        PatientAccessLink @relation(fields: [linkId], references: [id])
  channel     AccessLinkChannel
  purpose     AccessLinkPurpose @default(EXERCISES)
  /// Set when the link went out with an exercise sheet (in the text of its email, or as access sheet with the print)
  handoutId   String?
  recipient   String?
  /// Email only; null for screen and print
  status      EmailStatus?
  attempts    Int               @default(0)
  lastError   String?
  sentAt      DateTime?
  requestedBy String
  /// Iteration 16: address of the therapist who sent it, for Reply-To; null for the practice contact address
  replyTo     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([linkId, createdAt])
}

/// Device signed in after the confirmation with the date of birth (cookie with a random id, stored as SHA-256)
model PatientZoneSession {
  practiceId String            @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice   Practice          @relation(fields: [practiceId], references: [id])
  id         String            @id @default(cuid())
  idHash     String            @unique
  linkId     String
  link       PatientAccessLink @relation(fields: [linkId], references: [id])
  patientId  String
  patient    Patient           @relation(fields: [patientId], references: [id])
  createdAt  DateTime          @default(now())
  /// createdAt + 30 days
  expiresAt  DateTime
  /// "Abmelden", link revoked or expired
  endedAt    DateTime?
  lastSeenAt DateTime?

  entries           ExerciseLogEntry[]
  signatureSessions SignatureSession[]

  @@index([patientId])
}

/// Confirmation attempt, for the limit per IP address (20 per hour). Deleted after 30 days by the migration job.
model PatientZoneAttempt {
  id      String             @id @default(cuid())
  /// HMAC-SHA-256 of the IP address with PATIENT_ZONE_SECRET
  ipHash  String
  linkId  String?
  link    PatientAccessLink? @relation(fields: [linkId], references: [id])
  success Boolean
  at      DateTime           @default(now())

  @@index([ipHash, at])
}

/// Übungstagebuch: one execution recorded by the patient. Deleting only sets deletedAt; the practice reads only.
model ExerciseLogEntry {
  practiceId     String              @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice       Practice            @relation(fields: [practiceId], references: [id])
  id             String              @id @default(cuid())
  patientId      String
  patient        Patient             @relation(fields: [patientId], references: [id])
  consultationId String
  exerciseCode   String
  prescription   HomePrescription    @relation(fields: [consultationId, exerciseCode], references: [consultationId, exerciseCode])
  sessionId      String?
  session        PatientZoneSession? @relation(fields: [sessionId], references: [id])
  performedAt    DateTime
  done           Boolean
  /// 1 (gar nicht) to 10 (sehr gut); only when done
  rating         Int?
  /// At most 500 characters
  note           String?
  /// "Alle heutigen Übungen erledigt"
  quick          Boolean             @default(false)
  createdAt      DateTime            @default(now())
  correctedAt    DateTime?
  deletedAt      DateTime?

  @@index([patientId, performedAt])
  @@index([consultationId, exerciseCode])
}

// ---------- Practices (iteration 12, design D1, D3, D5) ----------

enum PracticeStatus {
  ACTIVE
  SUSPENDED
}

enum PracticeRole {
  PRACTICE_ADMIN
  THERAPIST
}

/// A practice (tenant). Every patient-related row belongs to exactly one practice; PostgreSQL row-level security
/// limits each request to the practice in the setting app.practice_id (prisma/rls.sql).
model Practice {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  status          PracticeStatus @default(ACTIVE)
  /// One line as printed in PDF footers, e.g. "Pain Therapy | Via Prau da Cuort 5 | 7153 Falera"
  addressLine     String
  street          String?
  zip             String?
  city            String?
  defaultPlace    String
  contactEmail    String
  phone           String?
  /// Logo (PNG or JPEG, at most 500 KB) for app, zone and PDFs; null shows the name as text (design D5)
  logo            Bytes?
  logoType        String?
  /// Own text of the zone privacy notice (paragraphs); null uses the platform template with the practice details
  privacyNotice   String?
  /// Iteration 17 (design D4): «Verantwortliche Person» of the privacy notice; empty shows the practice name alone
  privacyOfficer  String?
  /// Iteration 17 (design D3): template version of the consent form the practice adopted or dismissed
  templateSeen    Int            @default(1)
  /// Iteration 17 (design D7): plan with the patient limit, changed only by the platform admin
  planId          String         @default("freemium")
  plan            Plan           @relation(fields: [planId], references: [id])
  planChangedAt   DateTime?
  planChangedBy   String?
  /// Iteration 17 (design D8): set when the platform admin got the mail about the reached limit; reset on a plan change
  limitNotifiedAt DateTime?
  documentPrefix  String         @default("PT")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  /// Set when the platform deleted the practice's data (design D9); the row keeps the slug from being given again
  deletedAt       DateTime?

  memberships           PracticeMembership[]
  invitations           Invitation[]
  /// Iteration 16 (design D5): mailboxes the practice admin may have created at pain-therapy.online
  mailboxQuota          Int                    @default(5)
  mailboxes             MailboxProvisioning[]
  patients              Patient[]
  anamneses             Anamnesis[]
  consentTexts          ConsentTextVersion[]
  signatureSessions     SignatureSession[]
  consents              Consent[]
  signedDocuments       SignedDocument[]
  emailDeliveries       EmailDelivery[]
  treatments            Treatment[]
  consultations         Consultation[]
  consultationPoints    ConsultationPoint[]
  consultationExercises ConsultationExercise[]
  clinicalPhotos        ClinicalPhoto[]
  homePrescriptions     HomePrescription[]
  exerciseHandouts      ExerciseHandout[]
  handoutDeliveries     HandoutDelivery[]
  accessLinks           PatientAccessLink[]
  accessLinkDeliveries  AccessLinkDelivery[]
  zoneSessions          PatientZoneSession[]
  logEntries            ExerciseLogEntry[]
  auditEvents           AuditEvent[]
  documentCounters      DocumentCounter[]
  exports               PracticeExport[]
  photoHandoffs         PhotoHandoff[]
  photoHandoffUploads   PhotoHandoffUpload[]
}

/// Iteration 17 (design D7): plan of a practice; patientLimit null = unlimited. No prices (commercial terms open).
model Plan {
  id           String     @id
  name         String     @unique
  patientLimit Int?
  sortOrder    Int        @default(0)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  practices    Practice[]
}

enum ExportStatus {
  PENDING
  DONE
  FAILED
}

/// Export of a practice as ZIP (design D9): PDFs, photos and the data as JSON; download for 24 hours
model PracticeExport {
  practiceId  String       @default(dbgenerated("current_setting('app.practice_id'::text, true)"))
  practice    Practice     @relation(fields: [practiceId], references: [id])
  id          String       @id @default(cuid())
  status      ExportStatus @default(PENDING)
  requestedBy String
  blobPath    String?
  sizeBytes   Int?
  error       String?
  createdAt   DateTime     @default(now())
  finishedAt  DateTime?
  expiresAt   DateTime?

  @@index([practiceId, createdAt])
}

/// Signed PDFs of a deleted practice still under WORM retention; a job removes them afterwards (design D9)
model PendingBlobDeletion {
  id          String    @id @default(cuid())
  practiceId  String
  container   String
  path        String
  deleteAfter DateTime
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([deleteAfter])
}

/// Membership of a user in a practice, with roles per practice (design D3)
model PracticeMembership {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  practiceId String
  practice   Practice       @relation(fields: [practiceId], references: [id])
  roles      PracticeRole[]
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())

  @@unique([userId, practiceId])
  @@index([practiceId])
}

/// Iteration 16 (design D1)
enum InvitationChannel {
  EMAIL
  SMS
  /// Iteration 19: SMS and e-mail with the same link
  BOTH
}

enum SmsPurpose {
  INVITATION
  CODE
  MAILBOX_READY
}

enum SmsStatus {
  SENT
  FAILED
}

/// Every SMS sent (design D2): masked recipient, never the text or a code. Counts for the limits per invitation
/// (5 per hour) and for the platform (50 per day).
model SmsMessage {
  id           String      @id @default(cuid())
  /// e.g. "+41 79 *** ** 67"
  toMasked     String
  purpose      SmsPurpose
  status       SmsStatus
  error        String?
  invitationId String?
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  userId       String?
  createdAt    DateTime    @default(now())

  @@index([createdAt])
  @@index([invitationId, createdAt])
}

/// Iteration 16 (design D3)
enum MailboxMode {
  NEW
  EXISTING
}

enum MailboxStatus {
  CREATED
  FAILED
  DELETED
}

/// Access of the person to the mailbox (design D4)
enum MailboxAccess {
  /// The platform admin still has to create a device password at Infomaniak and hand it over
  OPEN
  /// Handed over, waiting to be shown once (at most 14 days)
  READY
  /// Shown once and deleted
  DELIVERED
  /// Not picked up within 14 days, deleted
  EXPIRED
}

/// A mailbox at pain-therapy.online that the app created or uses for a person (design D3, D4). Only the device
/// password of a handover is kept, encrypted, until it is shown once or expires.
model MailboxProvisioning {
  id                String        @id @default(cuid())
  /// Full address, lower case
  address           String        @unique
  mode              MailboxMode
  status            MailboxStatus
  lastError         String?
  practiceId        String?
  practice          Practice?     @relation(fields: [practiceId], references: [id])
  invitationId      String?       @unique
  invitation        Invitation?   @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  access            MailboxAccess @default(OPEN)
  /// AES-256-GCM (src/lib/auth/crypto.ts), only while access = READY
  handoverEnc       String?
  handoverExpiresAt DateTime?
  handedOverAt      DateTime?
  deliveredAt       DateTime?
  /// When the person asked for a new access under «Mein Profil»
  requestedAt       DateTime?
  /// Apple profile behind a one-time link (10 minutes), encrypted, cleared when downloaded
  profileTokenHash  String?       @unique
  profileEnc        String?
  profileExpiresAt  DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([practiceId])
  @@index([access])
}
