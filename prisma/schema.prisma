// Data model for Iteration 1 (see openspec/changes/iteration-1-scaffolding-patient-management/design.md, D5),
// Iteration 2 (openspec/changes/iteration-2-treatments/design.md, D1) and Iteration 3
// (openspec/changes/iteration-3-home-exercises/design.md, D2, D4, D5)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  THERAPIST
  ADMIN
}

enum Language {
  de
  en
}

enum Gender {
  m
  w
  d
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum YesNo {
  YES
  NO
}

enum Pregnancy {
  YES
  NO
  NOT_APPLICABLE
}

enum SignatureStatus {
  OPEN
  ABORTED
  SIGNED
}

/// Where the patient signed (iteration 5, design D6)
enum SignatureChannel {
  IPAD
  PATIENT_ZONE
}

enum ConsentKind {
  LIABILITY_WAIVER
  DATA_PROCESSING
  UNENCRYPTED_EMAIL
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_NO_CONSENT
  SKIPPED_NO_ADDRESS
}

/// Berufsbezeichnung (user-profile, iteration 8 design D9): "Therapeutin" or "Therapeut"
enum ProfessionalTitle {
  THERAPIST_F
  THERAPIST_M
}

/// A signed-in Ayanta user. Created on first sign-in from the Entra ID token.
model User {
  id          String            @id @default(cuid())
  entraOid    String            @unique
  email       String
  name        String
  /// "Hallo <displayName>"; first name from Entra until the user changes it under "Mein Profil"
  displayName String?
  title       ProfessionalTitle @default(THERAPIST_F)
  roles       Role[]
  locale      Language          @default(de)
  place       String?
  createdAt   DateTime          @default(now())
  lastLoginAt DateTime          @default(now())
  /// Sessions issued before this time are rejected (sign-out, access-control)
  signedOutAt DateTime?
}

model Patient {
  id                 String        @id @default(cuid())
  firstName          String
  lastName           String
  gender             Gender?
  dateOfBirth        DateTime      @db.Date
  preferredLanguage  Language      @default(de)
  occupation         String?
  gp                 String?
  street             String?
  zip                String?
  city               String?
  phone              String?
  mobile             String?
  email              String?
  emergencyName      String?
  emergencyPhone     String?
  insurer            String?
  insuranceNumber    String?
  status             PatientStatus @default(ACTIVE)
  deactivatedAt      DateTime?
  deactivationReason String?
  createdAt          DateTime      @default(now())
  createdBy          String
  updatedAt          DateTime      @updatedAt
  updatedBy          String

  anamnesis         Anamnesis?
  signatureSessions SignatureSession[]
  documents         SignedDocument[]
  auditEvents       AuditEvent[]
  treatments        Treatment[]
  handouts          ExerciseHandout[]
  accessLinks       PatientAccessLink[]
  zoneSessions      PatientZoneSession[]
  exerciseLog       ExerciseLogEntry[]

  @@index([lastName, dateOfBirth])
  @@index([status, lastName])
}

/// Medical part of the intake form ("Anamnese L&B-Patienten", page 2)
model Anamnesis {
  patientId         String    @id
  patient           Patient   @relation(fields: [patientId], references: [id])
  smoker            YesNo     @default(NO)
  smokingYears      Int?
  packsPerDay       Decimal?  @db.Decimal(4, 1)
  highBloodPressure Boolean   @default(false)
  highBloodLipids   Boolean   @default(false)
  dizziness         Boolean   @default(false)
  osteoporosis      Boolean   @default(false)
  arthrosis         Boolean   @default(false)
  rheumatism        Boolean   @default(false)
  orthoOther        Boolean   @default(false)
  orthoOtherText    String?
  cardiovascular    Boolean   @default(false)
  diabetes          Boolean   @default(false)
  asthma            Boolean   @default(false)
  allergies         Boolean   @default(false)
  internalOther     Boolean   @default(false)
  internalOtherText String?
  furtherDiagnoses  String?
  medication        String?
  pregnancy         Pregnancy @default(NOT_APPLICABLE)
  inTreatment       YesNo     @default(NO)
  treatingDoctor    String?
}

/// Versioned disclaimer text (liability waiver, patient information, privacy notice), one row per version and language
model ConsentTextVersion {
  id          String   @id @default(cuid())
  version     Int
  language    Language
  title       String
  body        String
  publishedAt DateTime @default(now())
  publishedBy String

  sessions SignatureSession[]

  @@unique([version, language])
}

model SignatureSession {
  id              String              @id @default(cuid())
  patientId       String
  patient         Patient             @relation(fields: [patientId], references: [id])
  textVersionId   String
  textVersion     ConsentTextVersion  @relation(fields: [textVersionId], references: [id])
  language        Language
  status          SignatureStatus     @default(OPEN)
  startedBy       String
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  abortedAt       DateTime?
  patientNote     String?
  place           String?
  signaturePoints Json?
  signatureSvg    String?
  channel         SignatureChannel    @default(IPAD)
  /// Device session of the patient zone that opened the form (channel PATIENT_ZONE)
  zoneSessionId   String?
  zoneSession     PatientZoneSession? @relation(fields: [zoneSessionId], references: [id])
  /// "Erledigt" on the patient's remark about her personal details
  noteResolvedAt  DateTime?
  noteResolvedBy  String?

  consents Consent[]
  document SignedDocument?

  @@index([patientId, startedAt])
  @@index([status, completedAt])
}

model Consent {
  id        String           @id @default(cuid())
  sessionId String
  session   SignatureSession @relation(fields: [sessionId], references: [id])
  kind      ConsentKind
  granted   Boolean
  createdAt DateTime         @default(now())

  @@unique([sessionId, kind])
}

/// Archived PDF. Rows are immutable (enforced by a database trigger); the file lives in immutable Blob Storage.
model SignedDocument {
  id             String           @id @default(cuid())
  documentNumber String           @unique
  patientId      String
  patient        Patient          @relation(fields: [patientId], references: [id])
  sessionId      String           @unique
  session        SignatureSession @relation(fields: [sessionId], references: [id])
  textVersion    Int
  language       Language
  blobPath       String
  sha256         String
  sizeBytes      Int
  createdAt      DateTime         @default(now())

  deliveries EmailDelivery[]

  @@index([patientId, createdAt])
}

model EmailDelivery {
  id          String         @id @default(cuid())
  documentId  String
  document    SignedDocument @relation(fields: [documentId], references: [id])
  recipient   String?
  status      EmailStatus    @default(PENDING)
  attempts    Int            @default(0)
  lastError   String?
  sentAt      DateTime?
  requestedBy String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

/// Append-only access and change log (enforced by a database trigger)
model AuditEvent {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  userId    String
  userName  String
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])
  action    String
  field     String?
  before    String?
  after     String?
  details   Json?

  @@index([patientId, at])
}

/// Sequence for human-readable document numbers (PT-YYYY-NNNNN)
model DocumentCounter {
  year Int @id
  last Int @default(0)
}

// ---------- Therapy catalog (therapy-catalog, design D2) ----------
// Loaded from prisma/catalog/ by `npm run catalog:sync`. Rows are never deleted; entries that disappear from the
// reference files get `retiredAt` so recorded consultations keep their meaning.

/// Emphasis of a point on the paper form: orange bold, orange, black
enum PointEmphasis {
  main
  relevant
  standard
}

/// Bereich (body-areas, iteration 8 design D1): 1 Kopf, 2 Rumpf, 3 Schulter/Arm, 4 Becken/Beine
model BodyArea {
  id        Int       @id
  nameDe    String
  nameEn    String
  retiredAt DateTime?

  regions   Region[]
  points    OsteopressurePoint[]
  exercises Exercise[]
}

/// Schmerzbereich: one of the 12 treatment areas (Behandlungsbögen) of the Sammelmappe, "1.1" to "4.3"
model Region {
  id         Int       @id
  /// "<Bereich>.<n>", e.g. "1.2"
  code       String
  bodyAreaId Int
  bodyArea   BodyArea  @relation(fields: [bodyAreaId], references: [id])
  nameDe     String
  nameEn     String
  sheetTitle String
  retiredAt  DateTime?

  points     RegionPoint[]
  exercises  RegionExercise[]
  treatments Treatment[]
}

model OsteopressurePoint {
  /// e.g. "2.11.1"
  id                    String    @id
  /// Bereich (iteration 8 design D1; formerly "Gruppe")
  group                 Int
  bodyArea              BodyArea  @relation(fields: [group], references: [id])
  muscleAttachmentLatin String
  attachmentDe          String
  /// Order of the reference file (numeric by ID)
  sort                  Int
  retiredAt             DateTime?

  regions       RegionPoint[]
  consultations ConsultationPoint[]
}

/// A point on the form of an area, in paper order
model RegionPoint {
  regionId  Int
  region    Region             @relation(fields: [regionId], references: [id])
  pointId   String
  point     OsteopressurePoint @relation(fields: [pointId], references: [id])
  emphasis  PointEmphasis
  sort      Int
  retiredAt DateTime?

  @@id([regionId, pointId])
}

/// Engpassdehnung 1A to 4G
model Exercise {
  code         String    @id
  /// Bereich (iteration 8 design D1; formerly "Gruppe")
  group        Int
  bodyArea     BodyArea  @relation(fields: [group], references: [id])
  nameDe       String
  nameEn       String
  stretchSteps Int?
  /// [{ order, toolCode, areaDe, note? }], null while not yet captured
  rolling      Json?
  /// [{ order, de }], null while not yet captured
  variants     Json?
  source       String?
  sort         Int
  retiredAt    DateTime?

  regions       RegionExercise[]
  consultations ConsultationExercise[]
  sheet         ExerciseSheet?
  prescriptions HomePrescription[]
  epdVariants   ExerciseVariant[]
}

/// Variante der Engpassdehnung (exercise-segments, iteration 8 design D2). Texts in ExerciseSheet.segments.
model ExerciseVariant {
  exerciseCode String
  exercise     Exercise  @relation(fields: [exerciseCode], references: [code])
  /// 1…n per exercise
  number       Int
  /// Numbers of the images in the variant band, e.g. [1, 2]
  images       Int[]
  aids         String[]
  /// null: same as the standard exercise
  seconds      Int?
  retiredAt    DateTime?

  @@id([exerciseCode, number])
}

model RegionExercise {
  regionId     Int
  region       Region    @relation(fields: [regionId], references: [id])
  exerciseCode String
  exercise     Exercise  @relation(fields: [exerciseCode], references: [code])
  sort         Int
  retiredAt    DateTime?

  @@id([regionId, exerciseCode])
}

/// Fascia rolling tool (MiKu, MeKu, MiRo, MeRo)
model RollingTool {
  code      String    @id
  nameDe    String
  nameEn    String
  sort      Int
  retiredAt DateTime?
}

// ---------- Treatments and consultations (design D1, D4) ----------

enum Sensitivity {
  LOW
  MEDIUM
  STRONG
  EXTREME
}

/// "Übung fällt"
enum Difficulty {
  EASY
  MEDIUM
  HARD
  IMPOSSIBLE
}

/// Körperseite of a treatment (session-form, iteration 8 design D4)
enum Side {
  UNSPECIFIED
  LEFT
  RIGHT
}

/// One treatment per pain area; never deleted (database trigger)
model Treatment {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  startedAt DateTime
  regionId  Int
  region    Region   @relation(fields: [regionId], references: [id])
  /// Fixed after the first session, like the pain area
  side      Side     @default(UNSPECIFIED)
  /// "Schmerzlokalisation und Schmerzzustand" (iteration 8 design D10)
  diagnosis String
  /// Pain at the start in percent, 0 to 100 in steps of 10
  painStart Int
  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String

  consultations Consultation[]
  photos        ClinicalPhoto[]

  @@index([patientId, startedAt])
}

/// One session, i.e. one paper form; never deleted (database trigger)
model Consultation {
  id          String    @id @default(cuid())
  treatmentId String
  treatment   Treatment @relation(fields: [treatmentId], references: [id])
  /// "Behandlung Nr." on the paper form: 1, 2, 3 … within the treatment, fixed when created
  number      Int
  at          DateTime
  diagnosis   String
  painBefore  Int?
  /// Residual pain after the consultation
  painAfter   Int?
  comparison  String?
  createdAt   DateTime  @default(now())
  createdBy   String
  updatedAt   DateTime  @updatedAt
  updatedBy   String

  points    ConsultationPoint[]
  exercises ConsultationExercise[]
  photos    ClinicalPhoto[]
  home      HomePrescription[]
  handouts  ExerciseHandout[]

  @@unique([treatmentId, number])
}

/// Only stored when at least one value is given
model ConsultationPoint {
  consultationId String
  consultation   Consultation       @relation(fields: [consultationId], references: [id])
  pointId        String
  point          OsteopressurePoint @relation(fields: [pointId], references: [id])
  left           Boolean            @default(false)
  right          Boolean            @default(false)
  sensitivity    Sensitivity?

  @@id([consultationId, pointId])
}

model ConsultationExercise {
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  exerciseCode   String
  exercise       Exercise     @relation(fields: [exerciseCode], references: [code])
  /// Prescribed = performed in the session and part of the home program (iteration 8 design D6)
  prescribed     Boolean      @default(false)
  /// Required when prescribed
  difficulty     Difficulty?
  /// EPD: null = Standardübung, otherwise the number of the ExerciseVariant
  variant        Int?

  @@id([consultationId, exerciseCode])
}

// ---------- Clinical photos (clinical-photos, design D5, D6) ----------

/// Photo of a treatment, optionally of one of its consultations. Removing only hides it; the file stays.
model ClinicalPhoto {
  id             String        @id @default(cuid())
  treatmentId    String
  treatment      Treatment     @relation(fields: [treatmentId], references: [id])
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  blobPath       String
  thumbPath      String
  sha256         String
  width          Int
  height         Int
  sizeBytes      Int
  /// When the photo was taken (EXIF DateTimeOriginal), otherwise when it was added
  takenAt        DateTime
  uploadedAt     DateTime      @default(now())
  uploadedBy     String
  removedAt      DateTime?
  removedBy      String?

  @@index([treatmentId, takenAt])
  @@index([consultationId])
}

// ---------- Exercise sheets (exercise-library, iteration 3 design D1 to D3) ----------
// Timing and file names from prisma/catalog/exercise-sheets.json, texts from `exercises-content.json` in the
// private container `exercise-media` (never in the repository). Loaded by `npm run catalog:sync` like the catalog.

/// One of the 27 sheets of the "Sammelmappe 27 Übungsblätter"
model ExerciseSheet {
  exerciseCode          String    @id
  exercise              Exercise  @relation(fields: [exerciseCode], references: [code])
  /// Page in the Sammelmappe
  sheetPage             Int
  title                 String
  /// File names in the container `exercise-media`
  mainImage             String
  sheetImage            String
  /// ["Schritt 1", "Schritt 2", …] as printed on the sheet
  stepLabels            Json
  /// null: not yet set by the practice ("noch nicht festgelegt")
  stretchSecondsPerSide Int?
  sides                 Int
  rollingSeconds        Int?
  timingSource          String?
  /// Open points of the timing, e.g. "Dauer von der Praxis festlegen"
  timingTodo            Json?
  /// { rolling, steps: [{ label, text }], variants } from the container; null while "noch nicht erfasst"
  content               Json?
  /// FRM tools (iteration 8 design D2), e.g. ["MiKu", "MiRo"]
  rollingTools          String[]  @default([])
  /// Aids of the EPD standard exercise, e.g. ["Wand"]
  standardAids          String[]  @default([])
  /// FRM, Standardübung and Varianten from segments-content.json in the container; null while "noch nicht erfasst"
  segments              Json?
  retiredAt             DateTime?
}

// ---------- Home program and exercise handout (home-program, exercise-handout, design D4 to D6) ----------

/// Selbstausführung: one row per exercise prescribed in a session, always FRM + the chosen EPD (iteration 8 design D7)
model HomePrescription {
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  exerciseCode   String
  exercise       Exercise     @relation(fields: [exerciseCode], references: [code])
  /// Copy of ConsultationExercise.variant: null = EPD Standard
  variant        Int?
  /// 1 to 3 executions per day
  timesPerDay    Int          @default(1)
  /// Bit mask Mo = 1, Di = 2 … So = 64; 127 = every day, at least one day
  weekdays       Int          @default(127)
  note           String?

  logEntries ExerciseLogEntry[]

  @@id([consultationId, exerciseCode])
}

enum HandoutChannel {
  EMAIL
  PRINT
}

/// Personal exercise sheet (PDF). Rows are immutable (database trigger); the file lives in the document archive.
model ExerciseHandout {
  id             String       @id @default(cuid())
  documentNumber String       @unique
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  /// 1, 2, 3 … per consultation; the newest is the current one
  version        Int
  language       Language
  /// The prescriptions as printed, so older versions stay readable after changes
  prescriptions  Json
  blobPath       String
  sha256         String
  sizeBytes      Int
  createdAt      DateTime     @default(now())
  createdBy      String

  deliveries HandoutDelivery[]

  @@unique([consultationId, version])
  @@index([patientId, createdAt])
}

/// Email (with status and retries, like EmailDelivery) or printout of a handout; never deleted (database trigger)
model HandoutDelivery {
  id          String          @id @default(cuid())
  handoutId   String
  handout     ExerciseHandout @relation(fields: [handoutId], references: [id])
  channel     HandoutChannel
  recipient   String?
  /// Email only; null for a printout
  status      EmailStatus?
  attempts    Int             @default(0)
  lastError   String?
  sentAt      DateTime?
  requestedBy String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// ---------- Patient zone (patient-access, exercise-log; iteration 4 design D3 to D8) ----------
// Read and written by the separate app apps/patient-zone with the database role `patient_zone`
// (prisma/patient-zone-role.sql). The token of a link is never stored, only its SHA-256.

/// Personal link to the patient zone. One valid link per patient: a new link replaces the previous one.
model PatientAccessLink {
  id             String    @id @default(cuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id])
  /// SHA-256 (hex) of the token in https://<host>/l/<token>
  tokenHash      String    @unique
  createdBy      String
  createdAt      DateTime  @default(now())
  /// Issued + 6 months
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedBy      String?
  /// Set when a newer link of the same patient was issued; sessions opened with it stay valid
  replacedAt     DateTime?
  /// Failed confirmations with the date of birth since the last success
  failedAttempts Int       @default(0)
  /// 15 minutes after 5 failed confirmations
  lockedUntil    DateTime?
  /// After 10 failed confirmations, until the practice issues a new link
  blockedAt      DateTime?
  lastUsedAt     DateTime?

  deliveries AccessLinkDelivery[]
  sessions   PatientZoneSession[]
  attempts   PatientZoneAttempt[]

  @@index([patientId, createdAt])
}

/// "Link senden": by email (no attachment), shown as QR code on screen or printed as access sheet
enum AccessLinkChannel {
  EMAIL
  SCREEN
  PRINT
}

/// How a link reached the patient, with the email status like HandoutDelivery; never contains the token
/// Why a link went out: the home program (iteration 4) or the invitation to sign (iteration 5, design D3)
enum AccessLinkPurpose {
  EXERCISES
  SIGNATURE
}

model AccessLinkDelivery {
  id          String            @id @default(cuid())
  linkId      String
  link        PatientAccessLink @relation(fields: [linkId], references: [id])
  channel     AccessLinkChannel
  purpose     AccessLinkPurpose @default(EXERCISES)
  /// Set when the link went out with an exercise sheet (in the text of its email, or as access sheet with the print)
  handoutId   String?
  recipient   String?
  /// Email only; null for screen and print
  status      EmailStatus?
  attempts    Int               @default(0)
  lastError   String?
  sentAt      DateTime?
  requestedBy String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([linkId, createdAt])
}

/// Device signed in after the confirmation with the date of birth (cookie with a random id, stored as SHA-256)
model PatientZoneSession {
  id         String            @id @default(cuid())
  idHash     String            @unique
  linkId     String
  link       PatientAccessLink @relation(fields: [linkId], references: [id])
  patientId  String
  patient    Patient           @relation(fields: [patientId], references: [id])
  createdAt  DateTime          @default(now())
  /// createdAt + 30 days
  expiresAt  DateTime
  /// "Abmelden", link revoked or expired
  endedAt    DateTime?
  lastSeenAt DateTime?

  entries           ExerciseLogEntry[]
  signatureSessions SignatureSession[]

  @@index([patientId])
}

/// Confirmation attempt, for the limit per IP address (20 per hour). Deleted after 30 days by the migration job.
model PatientZoneAttempt {
  id      String             @id @default(cuid())
  /// HMAC-SHA-256 of the IP address with PATIENT_ZONE_SECRET
  ipHash  String
  linkId  String?
  link    PatientAccessLink? @relation(fields: [linkId], references: [id])
  success Boolean
  at      DateTime           @default(now())

  @@index([ipHash, at])
}

/// Übungstagebuch: one execution recorded by the patient. Deleting only sets deletedAt; the practice reads only.
model ExerciseLogEntry {
  id             String              @id @default(cuid())
  patientId      String
  patient        Patient             @relation(fields: [patientId], references: [id])
  consultationId String
  exerciseCode   String
  prescription   HomePrescription    @relation(fields: [consultationId, exerciseCode], references: [consultationId, exerciseCode])
  sessionId      String?
  session        PatientZoneSession? @relation(fields: [sessionId], references: [id])
  performedAt    DateTime
  done           Boolean
  /// 1 (gar nicht) to 10 (sehr gut); only when done
  rating         Int?
  /// At most 500 characters
  note           String?
  /// "Alle heutigen Übungen erledigt"
  quick          Boolean             @default(false)
  createdAt      DateTime            @default(now())
  correctedAt    DateTime?
  deletedAt      DateTime?

  @@index([patientId, performedAt])
  @@index([consultationId, exerciseCode])
}
