# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://app:app@localhost:5432/pain_therapy

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000
# Key for the TOTP secrets of the sign-in (32 bytes): openssl rand -base64 32. Required in production; locally it is
# derived from AUTH_SECRET when empty.
AUTH_ENCRYPTION_KEY=
# Local sign-in without email code (never active in Azure Container Apps)
AUTH_DEV_LOGIN=true

# --- Document archive and clinical photos ---
# local: files under STORAGE_LOCAL_DIR; azure: Blob Storage (managed identity, or a connection string for Azurite)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/documents
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=signed-documents
# Clinical photos (iteration 2): local folder and private Blob container
STORAGE_PHOTO_LOCAL_DIR=./data/clinical-photos
AZURE_STORAGE_PHOTO_CONTAINER=clinical-photos
# Exercise media (iteration 3): L&B pictures and exercises-content.json, never in the repository.
# Locally `npm run media:placeholders` writes synthetic placeholders here.
STORAGE_EXERCISE_LOCAL_DIR=./data/exercise-media
AZURE_STORAGE_EXERCISE_CONTAINER=exercise-media

# --- Email ---
# outbox: writes emails to MAIL_OUTBOX_DIR; smtp: Infomaniak SMTP; fail: always fails (tests)
# Mails carry only links, never documents (iteration 12, design D7)
MAIL_DRIVER=outbox
MAIL_OUTBOX_DIR=./data/outbox
MAIL_FROM=noreply@pain-therapy.online
# Only for MAIL_DRIVER=smtp; the password is the device password of noreply@ (Key Vault secret smtp-password)
# SMTP_HOST=mail.infomaniak.com
# SMTP_PORT=465
# SMTP_PASSWORD=

# --- SMS and mailboxes (iteration 16) ---
# outbox: writes SMS to SMS_OUTBOX_DIR; aspsms: sends over ASPSMS (default in Azure)
SMS_DRIVER=outbox
SMS_OUTBOX_DIR=./data/sms-outbox
# Only for SMS_DRIVER=aspsms (Key Vault secrets aspsms-userkey, aspsms-password)
# ASPSMS_USERKEY=
# ASPSMS_PASSWORD=
MAILBOX_DOMAIN=pain-therapy.online
# Without a token, mailboxes are kept in INFOMANIAK_FAKE_FILE locally (and switched off in Azure)
# INFOMANIAK_API_TOKEN=
# INFOMANIAK_ACCOUNT_ID=2550060
# INFOMANIAK_MAIL_HOSTING_ID=1127554
INFOMANIAK_FAKE_FILE=./data/infomaniak-fake.json

# Default place printed on the signed PDF
DEFAULT_PLACE=Falera

# Redirect HTTP to HTTPS behind a proxy that forwards x-forwarded-proto (set in Azure)
FORCE_HTTPS=false
