# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://app:app@localhost:5432/pain_therapy

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000
# Microsoft Entra ID app registration (docs/entra.md). Leave empty locally to use the development sign-in only.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
# Local sign-in without Entra ID (never active in Azure Container Apps)
AUTH_DEV_LOGIN=true

# --- Document archive ---
# local: files under STORAGE_LOCAL_DIR; azure: Blob Storage (managed identity, or a connection string for Azurite)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/documents
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=signed-documents

# --- Email ---
# outbox: writes emails to MAIL_OUTBOX_DIR; graph: Microsoft Graph sendMail; fail: always fails (tests)
MAIL_DRIVER=outbox
MAIL_OUTBOX_DIR=./data/outbox
MAIL_SENDER=pain-therapy@ayanta.ch

# Default place printed on the signed PDF
DEFAULT_PLACE=Mettmenstetten

# Redirect HTTP to HTTPS behind a proxy that forwards x-forwarded-proto (set in Azure)
FORCE_HTTPS=false
