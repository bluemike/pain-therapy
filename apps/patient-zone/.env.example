# Patient zone (apps/patient-zone), local development. See docs/local-development.md.
# Own database role patient_zone (created by `node prisma/patient-zone-role.mjs` with PATIENT_ZONE_DB_PASSWORD)
DATABASE_URL=postgresql://patient_zone:patient_zone@localhost:5432/pain_therapy
# HMAC key for IP addresses; any random value locally (openssl rand -base64 32)
PATIENT_ZONE_SECRET=change-me
STORAGE_DRIVER=local
# Same folder as the practice app (npm run media:placeholders)
STORAGE_EXERCISE_LOCAL_DIR=../../data/exercise-media
